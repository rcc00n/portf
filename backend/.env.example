DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_SSL=false
DJANGO_SERVE_MEDIA=true
DJANGO_SECURE_SSL_REDIRECT=false
# Export these values explicitly; Django does not automatically load dotenv files.
# Production requires a private stable DJANGO_SECRET_KEY and an attached PostgreSQL DATABASE_URL.
